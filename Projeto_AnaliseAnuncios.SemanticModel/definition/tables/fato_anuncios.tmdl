		variation Variation
			isDefault
			relationship: a9b95ce0-2536-47f0-840b-ef3d75f8101a
			defaultHierarchy: LocalDateTable_ab121a4e-6e7d-4b4e-a47c-93746e5d3cd7.'Hierarquia de datas'

