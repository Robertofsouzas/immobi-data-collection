	column Score_Oportunidade =
			
			VAR _preco_m2  = fato_anuncios[preco_m2]
			VAR _area      = fato_anuncios[area_m2]
			VAR _cond      = fato_anuncios[condominio]
			
			VAR _med_preco =
			    CALCULATE(
			        MEDIAN(fato_anuncios[preco_m2]),
			        ALLEXCEPT(fato_anuncios, fato_anuncios[bairro]),
			        fato_anuncios[tipo_negocio] = EARLIER(fato_anuncios[tipo_negocio])
			    )
			
			VAR _med_area =
			    CALCULATE(
			        MEDIAN(fato_anuncios[area_m2]),
			        FILTER(
			            fato_anuncios,
			            fato_anuncios[area_m2] <= 600
			        ),
			        ALLEXCEPT(fato_anuncios, fato_anuncios[bairro])
			    )
			
			VAR _med_cond =
			    CALCULATE(
			        MEDIAN(fato_anuncios[condominio]),
			        ALLEXCEPT(fato_anuncios, fato_anuncios[bairro])
			    )
			
			-- Yield: recalcula aqui pois medida não funciona em coluna calculada
			VAR _aluguel_bairro =
			    CALCULATE(
			        MEDIAN(fato_anuncios[preco_m2]),
			        fato_anuncios[tipo_negocio] = "Aluguel",
			        ALLEXCEPT(fato_anuncios, fato_anuncios[bairro])
			    )
			VAR _venda_bairro =
			    CALCULATE(
			        MEDIAN(fato_anuncios[preco_m2]),
			        fato_anuncios[tipo_negocio] = "Venda",
			        ALLEXCEPT(fato_anuncios, fato_anuncios[bairro])
			    )
			VAR _qtd_aluguel =
			    CALCULATE(
			        COUNTROWS(fato_anuncios),
			        fato_anuncios[tipo_negocio]= "Aluguel",
			        ALLEXCEPT(fato_anuncios, fato_anuncios[bairro])
			    )
			VAR _qtd_venda =
			    CALCULATE(
			        COUNTROWS(fato_anuncios),
			        fato_anuncios[tipo_negocio] = "Venda",
			        ALLEXCEPT(fato_anuncios, fato_anuncios[bairro])
			    )
			VAR _yield =
			    IF(
			        _qtd_aluguel >= 10 && _qtd_venda >= 10,
			        DIVIDE(_aluguel_bairro, _venda_bairro, BLANK()),
			        BLANK()
			    )
			
			-- Pontuações
			VAR _pts_preco =
			    SWITCH(TRUE(),
			        _preco_m2 < _med_preco * 0.80, 35,
			        _preco_m2 < _med_preco * 0.90, 25,
			        _preco_m2 < _med_preco * 1.00, 15,
			        0
			    )
			
			VAR _pts_area =
			    SWITCH(TRUE(),
			        _area > _med_area * 1.20, 25,
			        _area > _med_area * 1.10, 17,
			        _area > _med_area * 1.00, 10,
			        0
			    )
			
			VAR _pts_cond =
			    SWITCH(TRUE(),
			        ISBLANK(_cond),            0,
			        _cond < _med_cond * 0.70, 15,
			        _cond < _med_cond * 0.90, 10,
			        _cond < _med_cond * 1.00,  5,
			        0
			    )
			
			VAR _pts_yield =
			    SWITCH(TRUE(),
			        ISBLANK(_yield),  0,
			        _yield > 0.008,  25,
			        _yield > 0.007,  18,
			        _yield > 0.006,  10,
			        0
			    )
			
			RETURN
			    _pts_preco + _pts_area + _pts_cond + _pts_yield
		formatString: 0
		lineageTag: c5fc57b0-1f38-477c-b346-771f28f6adfe
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Faixa_Score =
			
			SWITCH(
			    TRUE(),
			    fato_anuncios[Score_Oportunidade] >= 70, "🟢 Premium",
			    fato_anuncios[Score_Oportunidade] >= 50, "🟡 Bom",
			    fato_anuncios[Score_Oportunidade] >= 30, "🟠 Regular",
			    "🔴 Baixo"
			)
		lineageTag: 255b11ad-eb3f-424c-a0b4-0c500d8383f0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ordem_Faixa =
			
			SWITCH(
			    fato_anuncios[Faixa_Score],
			    "🟢 Premium", 1,
			    "🟡 Bom",     2,
			    "🟠 Regular", 3,
			    "🔴 Baixo",   4
			)
		formatString: 0
		lineageTag: 374170d6-f0d9-4541-a1c1-52b7c5bd309d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Faixa_Preco =
			
			SWITCH(
			    TRUE(),
			    -- ALUGUEL
			    fato_anuncios[tipo_negocio] = "Aluguel" && fato_anuncios[preco_atual] < 2000,                                                "Até R$ 2k",
			    fato_anuncios[tipo_negocio] = "Aluguel" && fato_anuncios[preco_atual] < 4000,                                                "R$ 2k – 4k",
			    fato_anuncios[tipo_negocio] = "Aluguel" && fato_anuncios[preco_atual] < 7000,                                                "R$ 4k – 7k",
			    fato_anuncios[tipo_negocio] = "Aluguel" && fato_anuncios[preco_atual] < 12000,                                               "R$ 7k – 12k",
			    fato_anuncios[tipo_negocio] = "Aluguel",                                                                                     "Acima R$ 12k",
			
			    -- VENDA
			    fato_anuncios[tipo_negocio] = "Venda" && fato_anuncios[preco_atual] < 300000,                                                "Até R$ 300k",
			    fato_anuncios[tipo_negocio] = "Venda" && fato_anuncios[preco_atual] < 600000,                                                "R$ 300k – 600k",
			    fato_anuncios[tipo_negocio] = "Venda" && fato_anuncios[preco_atual] < 1000000,                                               "R$ 600k – 1M",
			    fato_anuncios[tipo_negocio] = "Venda" && fato_anuncios[preco_atual] < 2000000,                                               "R$ 1M – 2M",
			    fato_anuncios[tipo_negocio] = "Venda",                                                                                       "Acima R$ 2M",
			
			    "Indefinido"
			)
		lineageTag: ca497168-026d-4704-97eb-6d645da38950
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

