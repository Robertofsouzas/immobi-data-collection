	partition dim_calendario = m
		mode: import
		source = ```
				let
				    // Altere as datas abaixo conforme a necessidade do seu histórico
				    DataMinima = #date(2026, 1, 1),
				    DataMaxima = #date(2028, 12, 31),
				    
				    // Conta quantos dias existem no intervalo
				    QuantidadeDias = Duration.Days(Duration.From(DataMaxima - DataMinima)) + 1,
				    
				    // Cria a lista de datas
				    Origem = List.Dates(DataMinima, QuantidadeDias, #duration(1, 0, 0, 0)),
				    #"Convertido para Tabela" = Table.FromList(Origem, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Convertido para Tabela",{{"Column1", "Data"}}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Colunas Renomeadas",{{"Data", type date}}),
				    
				    // Adiciona as colunas de tempo úteis para análise imobiliária
				    #"Ano Inserido" = Table.AddColumn(#"Tipo Alterado", "Ano",  each Date.Year([Data]), type number),
				    #"Nome do Mês Inserido" = Table.AddColumn(#"Ano Inserido", "Nome do Mês", each (Date.MonthName([Data])), type text),
				    #"Mês Inserido" = Table.AddColumn(#"Nome do Mês Inserido", "Mês Num", each Date.Month([Data]), type number),
				    #"Ano Mês Inserido" = Table.AddColumn(#"Mês Inserido", "Ano Mês Num", each Date.Year([Data]) * 100 + Date.Month([Data]), type number),
				    #"Ano Mês Texto" = Table.AddColumn(#"Ano Mês Inserido", "Ano Mês", each Text.Start([Nome do Mês],3) & "/" & Text.From([Ano]), type text),
				    #"Trimestre Inserido" = Table.AddColumn(#"Ano Mês Texto", "Trimestre", each "Tris " & Text.From(Date.QuarterOfYear([Data])), type text),
				    #"Semestre Inserido" = Table.AddColumn(#"Trimestre Inserido", "Semestre", each if Date.Month([Data]) <= 6 then "1º Semestre" else "2º Semestre", type text),
				    #"Dia da semana" = Table.AddColumn(#"Semestre Inserido", "Dia da semana", each Date.DayOfWeekName([Data]),type text ),
				    #"Dia da semana numero" = Table.AddColumn( #"Dia da semana", "Dia da semana num", each Date.DayOfWeek([Data]), type number)
				    
				   
				in
				    #"Dia da semana numero"
				```

